{
  "name": "lingo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "lint": "eslint . --max-warnings 0 && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "pnpm build && playwright test",
    "docs:build": "node scripts/docs/build.mjs",
    "check:unused": "knip",
    "check": "pnpm docs:build && pnpm check:unused && pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24 <25"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.64.1",
    "@types/chrome": "0.3.7",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "9.39.5",
    "github-slugger": "2.0.0",
    "globals": "16.4.0",
    "knip": "6.44.0",
    "prettier": "3.9.10",
    "remark-parse": "11.0.0",
    "typescript": "5.9.3",
    "unified": "11.0.5",
    "vitest": "5.0.5"
  }
}

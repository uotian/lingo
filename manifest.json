{
  "manifest_version": 3,
  "name": "Lingo",
  "version": "0.1.0",
  "description": "英語・日本語・中国語の対訳を表示。自分のOpenAI APIキーで使うページ翻訳。",
  "minimum_chrome_version": "120",
  "icons": {
    "16": "icons/lingo-16.png",
    "32": "icons/lingo-32.png",
    "48": "icons/lingo-48.png",
    "128": "icons/lingo-128.png"
  },
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["https://api.openai.com/*"],
  "optional_host_permissions": ["*://*/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Lingo：翻訳と設定",
    "default_icon": {
      "16": "icons/lingo-off-16.png",
      "32": "icons/lingo-off-32.png",
      "48": "icons/lingo-off-48.png"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
  },
  "options_page": "popup.html"
}
